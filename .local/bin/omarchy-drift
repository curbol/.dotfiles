#!/usr/bin/env bash
# Show what upstream omarchy changed since the last acknowledged baseline.
# Quattro ships its defaults as a package instead of a git checkout, so the
# baseline is a copy of the shipped trees rather than a commit. First run sets
# the baseline. Pass --ack after reviewing to advance it.

set -euo pipefail

root="${OMARCHY_PATH:-/usr/share/omarchy}"
state="$HOME/.cache/omarchy-drift"
baseline="$state/baseline"
stamp="$state/version"

watched=(
  "config:seeded into ~/.config once; upstream changes never re-apply"
  "install:runs only at install time; upstream fixes never reach this machine"
  "default:sourced live, but a new default can duplicate or fight an override"
)

ack=0
[[ "${1:-}" == "--ack" ]] && ack=1

version=$(pacman -Q omarchy 2>/dev/null | awk '{print $2}' || true)
[[ -n "$version" ]] || version="unknown"

snapshot() {
  local entry path
  rm -rf "$baseline"
  mkdir -p "$baseline"
  for entry in "${watched[@]}"; do
    path="${entry%%:*}"
    [[ -d "$root/$path" ]] && cp -a "$root/$path" "$baseline/$path"
  done
  printf '%s\n' "$version" >"$stamp"
}

mkdir -p "$state"

if [[ ! -d "$baseline" ]]; then
  snapshot
  echo "Baseline set to omarchy $version. Re-run after future updates."
  exit 0
fi

was=$(cat "$stamp" 2>/dev/null || echo unknown)

found=0
for entry in "${watched[@]}"; do
  path="${entry%%:*}"
  note="${entry#*:}"
  [[ -d "$root/$path" ]] || continue

  output=$(diff -ruN "$baseline/$path" "$root/$path" 2>/dev/null || true)
  [[ -n "$output" ]] || continue

  found=1
  echo "=== $path  ($note)"
  echo
  printf '%s\n\n' "$output"
done

if [[ $found -eq 0 ]]; then
  echo "No upstream changes since last check (omarchy $version)."
else
  echo "Upstream changes: omarchy $was -> $version"
fi

if [[ $ack -eq 1 ]]; then
  snapshot
  echo "Baseline advanced to omarchy $version."
fi
