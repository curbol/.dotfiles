#!/usr/bin/env bash
# Show upstream omarchy changes since the last acknowledged commit.
# First run sets the baseline. Subsequent runs list commits + diffs for each
# watched path since that baseline. Pass --ack after reviewing to advance it.

set -euo pipefail

repo="$HOME/.local/share/omarchy"
state="$HOME/.cache/omarchy-drift/last-checked"
mkdir -p "$(dirname "$state")"
cd "$repo"

ack=0
[[ "${1:-}" == "--ack" ]] && ack=1

head=$(git rev-parse HEAD)

if [[ ! -f "$state" ]] || ! git cat-file -e "$(cat "$state")" 2>/dev/null; then
  echo "$head" > "$state"
  echo "Baseline set to upstream HEAD ($head). Re-run after future updates."
  exit 0
fi

since=$(cat "$state")

if [[ "$since" == "$head" ]]; then
  echo "No upstream changes since last check."
  exit 0
fi

watched=(
  "config/:seeded into ~/.config once; upstream changes never re-apply"
  "install/:runs only at install time; upstream fixes never reach this machine"
  "default/:sourced live, but a new default can duplicate or fight an override"
)

found=0
for entry in "${watched[@]}"; do
  path="${entry%%:*}"
  note="${entry#*:}"
  [[ -n "$(git log --oneline "$since..$head" -- "$path")" ]] || continue
  found=1
  echo "=== $path  ($note)"
  echo
  git log --oneline "$since..$head" -- "$path"
  echo
  git diff "$since..$head" -- "$path"
  echo
done

((found)) || echo "No changes in watched paths ($since -> $head)."

if [[ $ack -eq 1 ]]; then
  echo "$head" > "$state"
  echo "Baseline advanced to $head."
fi
