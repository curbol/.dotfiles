{
  "env": {
    "PONYTAIL_DEFAULT_MODE": "lite"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(go *)",
      "Bash(make *)",
      "Bash(golangci-lint *)",
      "Bash(mise *)",
      "Bash(git:*)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(tsc *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(brew *)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tilt:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "mcp__shortcut",
      "mcp__claude_ai_Notion",
      "Read(/tmp/**)",
      "Write(/tmp/**)",
      "Edit(/tmp/**)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/curtis/code",
      "/home/curbol/code"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "[ -x ~/code/glados/node_modules/.bin/tsx ] || exit 0; ~/code/glados/node_modules/.bin/tsx ~/code/glados/.claude/scripts/hooks/pre-tool-use/index.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/longrun/scripts/keep-going.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "slack@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "work@gladly-claude-tools": true,
    "local-dev@gladly-claude-tools": true,
    "analyze-tests@gladly-claude-tools": false,
    "address-pr-comments@gladly-claude-tools": true,
    "test-deployed@gladly-claude-tools": true,
    "playwright@claude-plugins-official": true,
    "longrun@gladly-claude-tools": false,
    "pr-screenshots@gladly-claude-tools": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "glados-mcp@gladly-claude-tools": true,
    "tech-specs@gladly-claude-tools": true,
    "ai-arr-model@gladly-claude-tools": true,
    "flag-harness@gladly-claude-tools": true,
    "gladly@gladly-claude-tools": true,
    "incident-response@gladly-claude-tools": true,
    "shortcut@gladly-claude-tools": true,
    "datadog@claude-plugins-official": true,
    "pact-tests@gladly-claude-tools": true,
    "product-insight@gladly-claude-tools": true,
    "sumologic-mcp@synced": false
  },
  "extraKnownMarketplaces": {
    "gladly-claude-tools": {
      "source": {
        "source": "github",
        "repo": "sagansystems/gladly-claude-tools"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
